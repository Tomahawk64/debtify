MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>
JWT_SECRET=change_this_to_a_long_random_string
PORT=5000
NODE_ENV=development

# Redis — required for multi-server / PM2 cluster mode.
# Without this the app runs in single-process / in-memory mode (still works).
# Uncomment and set this when deploying to production with multiple workers/servers.
# REDIS_URL=redis://127.0.0.1:6379

# Production CORS — comma-separated list of allowed frontend origins.
# e.g. CORS_ORIGIN=http://123.45.67.89:7861,https://debtify.example.com
CORS_ORIGIN=

# GTI integration
WEBHOOK_GTI_URL=
GTI_EXPORT_KEY=change_me
GTI_POSTBACK_URL=
GTI_AUTH_HEADER=
GTI_TTL_DAYS=10
ALLOWED_IPS=""
VICIDIAL_HANGUP_URL=

# Loop Company Inbound Webhook — secret shared with Loop company
# They must include this value in the x-loop-secret request header on every POST.
# Generate a strong random value and share it securely with Loop company.
# Endpoint: POST https://<your-deployed-domain>/api/webhook/loop
LOOP_WEBHOOK_SECRET=change_me

# HRMS Attendance Webhook
HRMS_WEBHOOK_URL=http://localhost:5005/api/attendance/lms-event
HRMS_WEBHOOK_SECRET=change_me

# Meta Lead Ads (Instant Forms) Webhook
# META_VERIFY_TOKEN — any secret string you choose when registering the webhook in Meta Developer Portal
META_VERIFY_TOKEN=change_me
# META_APP_SECRET — found in Meta App Dashboard → Settings → Basic → App Secret
META_APP_SECRET=change_me
# META_ACCESS_TOKEN — Page Access Token or System User token with leads_retrieval permission
META_ACCESS_TOKEN=change_me

# Chat Microservice (optional) — set CHAT_SERVICE_URL to the deployed chat-service URL
# CHAT_SERVICE_SECRET must match LMS_SERVICE_SECRET in chat-service/.env
CHAT_SERVICE_URL=
CHAT_SERVICE_SECRET=
