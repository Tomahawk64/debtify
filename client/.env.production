# Left blank on purpose: deploy.sh builds the frontend WITHOUT these set,
# so API/socket.io calls go to the same origin (debtify.solutions) and
# Nginx (nginx/debtify.solutions.conf) routes them to the backend.
# Only set these if you deploy the frontend and backend on different domains.
# REACT_APP_API_URL=
# REACT_APP_SOCKET_URL=
